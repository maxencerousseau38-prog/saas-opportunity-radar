{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE", "CI"]
    }
  }
}
