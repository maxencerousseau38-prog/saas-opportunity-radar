{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "APP_ENV",
        "SITE_URL",
        "SUPABASE_SECRET_KEY"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": [
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
        "CI",
        "APP_ENV",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SEED_PASSWORD",
        "OWNER_ACCESS_TOKEN",
        "OWNER_ACCESS_EMAIL"
      ]
    }
  }
}
