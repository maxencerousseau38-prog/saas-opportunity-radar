# Template only — never commit real values (.env* files are git-ignored).
# Web app: copy the WEB section to apps/web/.env.local
# Worker:  export the WORKER section in the worker's environment
# Variables are validated at startup by @sor/contracts/env (names only are
# reported on error, never values). Supabase key names are re-verified in
# Sprint 1 against the local stack (Technical Blueprint §19).

# --- Shared ---------------------------------------------------------------
APP_ENV=local

# --- WEB (apps/web) ---------------------------------------------------------
# Browser-visible: only the API URL and the publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix with NEXT_PUBLIC_ (startup fails if you do).
SUPABASE_SECRET_KEY=

# --- WORKER (apps/worker) ---------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY= (same variable as above, server-side only)
WORKER_ID=worker-local-1
