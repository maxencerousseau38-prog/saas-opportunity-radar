{
  "name": "saas-opportunity-radar",
  "private": true,
  "description": "Evidence-first research platform for SaaS opportunities.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=10.34.9 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "benchmark:catalog": "node scripts/benchmark-catalog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:ingest": "pnpm --filter @sor/worker catalog:build && pnpm --filter @sor/worker catalog:ingest ../../data/catalog/wikidata/listings.json"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "supabase": "3.0.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
